---
/** Bottom of every sector page: one clear Back and one clear Next. */
import type { Sector } from '../lib/content';
import { stepsFor, type StepKey } from '../lib/flow';
import { href } from '../lib/url';
interface Props { sector: Sector; step: StepKey }
const { sector: s, step } = Astro.props;
const steps = stepsFor(s);
const i = steps.findIndex((x) => x.key === step);
const prev = i > 0 ? steps[i - 1] : { label: 'Playbook', href: href('/playbook/') };
const next = i < steps.length - 1 ? steps[i + 1] : null;
---
<nav class="stepnav no-print" aria-label="Next and previous step">
  <div class="container inner">
    <a class="back" href={prev.href} data-nav-dir="back"><span class="k">Back:</span> <span class="v">{prev.label}</span></a>
    <span class="pos">Step {i + 1} of {steps.length}</span>
    {next ? <a class="next" href={next.href}><span class="k">Next:</span> <span class="v">{next.label}</span></a> : <span class="spacer"></span>}
  </div>
</nav>
<style>
  .stepnav { position: relative; z-index: 3; border-top: var(--border); background: #fff; padding-block: var(--sp-4); }
  .inner { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: var(--sp-3); }
  a { display: inline-flex; align-items: center; gap: 0.3rem; min-height: 44px; padding: 0 1.1rem; border-radius: var(--radius-pill); font: 600 var(--fs-sm) var(--font-sans); text-decoration: none; width: fit-content; transition: background-color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease); }
  .k { font-weight: 500; }
  .back { justify-self: start; background: #fff; border: 1.5px solid var(--c-line); color: var(--c-ink); }
  .back .k { color: var(--c-muted); }
  .back:hover { border-color: var(--c-selected); color: var(--c-selected); }
  .next { justify-self: end; background: var(--c-selected); color: #fff; }
  .next:hover { background: var(--c-selected-hover); color: #fff; }
  .pos { font-size: var(--fs-xs); color: var(--c-muted); white-space: nowrap; }
  @media (max-width: 560px) { .pos { display: none; } .inner { grid-template-columns: 1fr 1fr; } }
</style>
