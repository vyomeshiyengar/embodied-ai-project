---
/**
 * The global map: every use case from the research.
 * Everything starts from the map: hover a pin for a preview, click it for the full story.
 * Logic in src/scripts/global-map.ts. Basemap: OpenFreeMap (OpenStreetMap data), with an offline
 * Natural Earth fallback if tiles can't load.
 */
import { sectors } from '../lib/content';
import { mapPoints } from '../lib/map-points';
interface Props {
  /** Sector id to show (locks the map to it). */
  sector?: string;
  /** Inside a sector's "On the map" step: no title or sector chips, a fixed height, no URL changes. */
  embedded?: boolean;
}
const { sector, embedded = false } = Astro.props;
const points = mapPoints();
const withPins = sectors.filter((s) => points.some((p) => p.sectorId === s.id));
---
<div class:list={['gmap', { embedded }]} data-gmap data-sector={sector} data-embedded={embedded ? '' : undefined}>
  <div class="mapbox" data-map role="region" aria-label="Map of places using embodied AI. Use the list of places below the filters to move by keyboard."></div>

  <div class="topbar">
    {!embedded && <h1>Global map</h1>}
    <div class="chips" role="group" aria-label="Show sector" data-fade hidden={embedded}>
      <button type="button" aria-pressed="true" data-sector="">All sectors</button>
      {withPins.map((s) => <button type="button" aria-pressed="false" data-sector={s.id} data-slug={s.slug}>{s.id} {s.short_name}</button>)}
    </div>
    <div class="chips small">
      <span class="count" aria-live="polite" data-count></span>
    </div>
    <details class="sr-places">
      <summary>List of places</summary>
      <ul data-sr-list></ul>
    </details>
  </div>

  <ul class="legend" aria-label="Legend">
    <li><span class="sym research"></span> Case from the research</li>
    <li><span class="sym swan"></span> Black swan case</li>
    <li><span class="sym approx"></span> Approximate location</li>
  </ul>

  <aside class="drawer" data-drawer hidden aria-labelledby="drawer-h" tabindex="-1">
    <button type="button" class="close" data-drawer-close aria-label="Close details">Close</button>
    <div data-drawer-body></div>
  </aside>

  <div class="hovercard" data-hover hidden></div>
  <p class="status" data-map-status hidden></p>
  <script type="application/json" data-points set:html={JSON.stringify(points)} />
</div>

<script>
  import { mountGlobalMap } from '../scripts/global-map';
  let cleanup: (() => void) | undefined;
  document.addEventListener('astro:page-load', () => {
    cleanup?.();
    const root = document.querySelector<HTMLElement>('[data-gmap]');
    cleanup = root ? mountGlobalMap(root) : undefined;
  });
  document.addEventListener('astro:before-swap', () => { cleanup?.(); cleanup = undefined; });
</script>

<style>
  .gmap { position: relative; height: calc(100vh - var(--header-h)); height: calc(100dvh - var(--header-h)); min-height: 520px; overflow: hidden; background: #cfe3f5; }
  .gmap.embedded { height: 70vh; height: 70dvh; min-height: 460px; border-radius: var(--radius-md); }
  .mapbox { position: absolute; inset: 0; }
  .topbar { position: absolute; z-index: 5; left: 1rem; top: 1rem; right: 1rem; max-width: 62rem; display: grid; gap: var(--sp-2); pointer-events: none; }
  .topbar > * { pointer-events: auto; }
  h1 { font-size: var(--fs-xl); margin: 0; background: #fff; width: fit-content; padding: 0.3rem 0.8rem; border-radius: var(--radius-sm); box-shadow: var(--shadow-panel); }
  .chips { display: flex; gap: 6px; overflow-x: auto; border: var(--border-overlay); padding: 4px; width: fit-content; max-width: 100%; background: #fff; border-radius: var(--radius-pill); box-shadow: var(--shadow-panel); }
  .chips button { flex: none; font: 600 var(--fs-sm) var(--font-sans); color: var(--c-ink); background: transparent; border: 0; border-radius: var(--radius-pill); padding: 0.45rem 0.9rem; min-height: 38px; cursor: pointer; transition: background-color var(--dur-med) var(--ease-out), color var(--dur-med) var(--ease-out); }
  .chips button[aria-pressed='true'] { background: var(--c-selected); color: #fff; }
  .chips.small button { font-size: var(--fs-xs); min-height: 32px; }
  .count { align-self: center; font-size: var(--fs-xs); color: var(--c-muted); padding: 0 0.6rem; white-space: nowrap; }
  .sr-places { border: var(--border-overlay); width: fit-content; background: #fff; border-radius: var(--radius-sm); box-shadow: var(--shadow-panel); font-size: var(--fs-xs); }
  .sr-places summary { cursor: pointer; padding: 0.35rem 0.75rem; color: var(--c-muted); }
  .sr-places ul { list-style: none; margin: 0; padding: var(--sp-2); max-height: 40vh; overflow: auto; width: min(80vw, 22rem); }
  .sr-places :global(button) { font: inherit; text-align: left; width: 100%; background: none; border: 0; padding: 0.35rem 0.5rem; border-radius: var(--radius-sm); cursor: pointer; color: var(--c-ink); }
  .sr-places :global(button:hover) { background: var(--c-surface-alt); }
  .legend { border: var(--border-overlay); position: absolute; z-index: 4; left: 1rem; bottom: 2rem; list-style: none; margin: 0; padding: var(--sp-3); background: rgb(255 255 255 / 0.95); border-radius: var(--radius-md); box-shadow: var(--shadow-panel); font-size: var(--fs-xs); display: grid; gap: 4px; }
  .legend li { display: flex; align-items: center; gap: 0.5rem; }
  .sym { width: 14px; height: 14px; display: inline-block; flex: none; }
  .sym.research { border-radius: 50%; background: var(--c-medium); }
  .sym.swan { background: var(--c-heritage); transform: rotate(45deg) scale(0.8); outline: 2px solid var(--c-gold); outline-offset: -2px; }
  .sym.approx { border-radius: 50%; background: #fff; border: 2px dashed var(--c-medium); }
  .drawer :global(.post) { border: 0; padding: 0; }
  .drawer :global(.save) { margin-top: var(--sp-3); }
  .drawer { border: var(--border-overlay); position: absolute; z-index: 8; right: 1rem; top: 4.5rem; bottom: 2rem; width: min(26rem, calc(100% - 2rem)); overflow: auto; background: #fff; border-radius: var(--radius-md); box-shadow: 0 16px 48px rgb(0 29 74 / 0.25); padding: var(--sp-5); animation: drawer-in var(--dur-panel) var(--ease-out) both; }
  .drawer[hidden] { display: none; }
  .chips[hidden] { display: none; }
  @keyframes drawer-in { from { opacity: 0; transform: translateX(40px); } to { opacity: 1; transform: none; } }
  .close { float: right; font: 600 var(--fs-xs) var(--font-sans); background: var(--c-surface-alt); border: 0; border-radius: var(--radius-pill); padding: 0.4rem 0.8rem; min-height: 32px; cursor: pointer; }
  .drawer :global(h2) { font-size: var(--fs-xl); margin: 0 0 var(--sp-2); }
  .drawer :global(.tags) { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: var(--sp-3); }
  .drawer :global(.tag) { font-size: var(--fs-xs); font-weight: 700; padding: 0.2rem 0.6rem; border-radius: var(--radius-pill); background: var(--c-surface-alt); color: var(--c-ink); }
  .drawer :global(.tag.swan) { background: var(--c-heritage); color: #fff; }
  .drawer :global(.tag.warn) { background: var(--c-pending-bg); color: var(--c-pending); }
  .drawer :global(dl) { margin: 0 0 var(--sp-3); display: grid; gap: var(--sp-3); font-size: var(--fs-sm); }
  .drawer :global(dt) { font-weight: 700; color: var(--c-ink); }
  .drawer :global(dd) { margin: 2px 0 0; }
  .drawer :global(.src) { font-size: var(--fs-xs); color: var(--c-muted); border-top: var(--border); padding-top: var(--sp-3); }
  .drawer :global(.src a) { display: block; margin-top: 2px; }
  .drawer :global(.pmedia) { margin: 0 0 var(--sp-3); border-radius: calc(var(--radius-md) - 4px); overflow: hidden; background: var(--c-surface-alt); }
  .drawer :global(.pmedia img) { display: block; width: 100%; height: auto; max-height: 14rem; object-fit: cover; }
  .drawer :global(.pmedia figcaption) { font-size: 0.72rem; padding: 0.3rem 0.5rem; color: var(--c-muted); }
  .drawer :global(.go) { display: flex; gap: var(--sp-2); flex-wrap: wrap; margin-top: var(--sp-4); }
  .hovercard { position: absolute; z-index: 7; pointer-events: none; width: 17rem; background: #fff; border: var(--border-overlay); border-radius: var(--radius-md); box-shadow: 0 10px 30px rgb(0 29 74 / 0.22); padding: var(--sp-3) var(--sp-4); font-size: var(--fs-xs); }
  .hovercard[hidden] { display: none; }
  .hovercard :global(strong) { display: block; font-size: var(--fs-sm); color: var(--c-ink); }
  .hovercard :global(.k) { color: var(--c-muted); font-weight: 600; }
  .status { border: var(--border-overlay); position: absolute; z-index: 4; left: 50%; transform: translateX(-50%); bottom: 1rem; margin: 0; max-width: 18rem; font-size: var(--fs-xs); background: #fff; border-radius: var(--radius-sm); padding: 0.4rem 0.7rem; box-shadow: var(--shadow-panel); }
  .gmap :global(.pin) { width: 22px; height: 22px; padding: 0; border: 3px solid #fff; background: var(--c-medium); border-radius: 50%; cursor: pointer; box-shadow: 0 1px 4px rgb(0 29 74 / 0.4); transition: transform var(--dur-med) var(--ease-out); }
  .gmap :global(.pin.approx) { border: 2.5px dashed var(--c-medium); background: #fff; }
  .gmap :global(.pin.swan) { background: var(--c-heritage); border-color: var(--c-gold); border-radius: 3px; transform: rotate(45deg); }
  .gmap :global(.pin:hover), .gmap :global(.pin:focus-visible), .gmap :global(.pin.on) { transform: scale(1.35); }
  .gmap :global(.pin.swan:hover), .gmap :global(.pin.swan:focus-visible), .gmap :global(.pin.swan.on) { transform: rotate(45deg) scale(1.35); }
  .gmap :global(.cluster) { min-width: 38px; height: 38px; padding: 0 8px; border-radius: 19px; border: 3px solid #fff; background: var(--c-heritage); color: #fff; font: 700 var(--fs-sm) var(--font-sans); cursor: pointer; box-shadow: 0 2px 8px rgb(0 29 74 / 0.35); }
  .gmap :global(.cluster:hover) { background: var(--c-heritage-deep); }
  @media (max-width: 760px) {
    .gmap { height: calc(100dvh - 7.5rem); }
    .legend { display: none; }
        h1 { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .topbar { left: 0.5rem; right: 0.5rem; top: 0.5rem; }
    .drawer { top: auto; left: 0.5rem; right: 0.5rem; bottom: 0.5rem; width: auto; max-height: 70%; }
  }
</style>
