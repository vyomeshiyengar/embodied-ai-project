---
/**
 * MyEACP: the signed-in demo user's city workspace. City profile, contributions to the map,
 * the city's own technologies and fleet contacts, saved items and questions.
 * Everything is stored in this browser (src/lib/workspace-store.ts). Nothing is seeded.
 * Logic in src/scripts/myeacp.ts.
 */
import Base from '../layouts/Base.astro';
import { sectors } from '../lib/content';
import { catalog } from '../lib/catalog';
import { mapPoints } from '../lib/map-points';
import { ROLES, TECH_STATUS } from '../lib/workspace-store';
import { href } from '../lib/url';
import '../styles/posts.css';
const points = mapPoints().map((p) => ({ id: p.id, sectorId: p.sectorId, sector: p.sectorShort, place: p.place, lat: p.lat, lng: p.lng, what: p.what, caseTitle: p.caseTitle, asOf: p.asOf, approx: p.approx }));
const TABS = [
  ['profile', 'Profile'],
  ['contrib', 'My contributions'],
  ['city', 'My city'],
  ['saved', 'Saved'],
  ['questions', 'Questions'],
] as const;
---
<Base title="MyEACP" description="Your city's workspace: profile, contributions, technologies, contacts and saved items.">
  <div class="my-head">
    <div class="container">
      <h1>MyEACP</h1>
    </div>
  </div>

  <div class="container page" data-my>
    <p class="visually-hidden" aria-live="polite" data-announce></p>

    <div class="gate" data-gate hidden>
      <h2>Sign in to open MyEACP</h2>
      <div class="gate-acts">
        <button type="button" class="btn" data-signin-open>Sign in</button>
        <a class="btn secondary" href={href('/playbook/')}>Continue browsing</a>
      </div>
    </div>

    <!-- Profile setup (first visit, or Edit profile) -->
    <form class="setup" data-setup data-astro-reload novalidate hidden aria-labelledby="setup-h">
      <h2 id="setup-h" data-setup-title>Set up your city</h2>
      <div class="combo">
        <label for="my-city">Your city</label>
        <input id="my-city" type="text" autocomplete="off" role="combobox" aria-controls="my-city-list" aria-expanded="false" aria-autocomplete="list" placeholder="Start typing, for example Pittsburgh" data-city-input />
        <ul id="my-city-list" role="listbox" aria-label="Cities" hidden data-city-list></ul>
        <p class="small muted" aria-live="polite" data-city-status></p>
      </div>
      <div class="two">
        <label>Department <input name="department" maxlength="80" placeholder="For example Department of Mobility and Infrastructure" /></label>
        <label>Your role
          <select name="role">
            {Object.entries(ROLES).map(([k, v]) => <option value={k}>{v}</option>)}
          </select>
        </label>
      </div>
      <fieldset class="secs">
        <legend>Sectors you work on</legend>
        {sectors.map((s) => <label class="check"><input type="checkbox" name="sectors" value={s.id} /> {s.id} {s.short_name}</label>)}
      </fieldset>
      <label>Display name <span class="muted">(optional)</span> <input name="displayName" maxlength="40" placeholder="For example Mobility team" /></label>
      <p class="err" role="alert" data-setup-error hidden></p>
      <div class="row">
        <button type="submit" class="btn">Save profile</button>
        <button type="button" class="btn secondary" data-setup-cancel hidden>Cancel</button>
      </div>
    </form>

    <!-- Workspace -->
    <div data-workspace hidden>
      <div class="card-id" data-idcard></div>

      <div class="cats big" role="tablist" aria-label="MyEACP" data-switch data-my-tabs>
        {TABS.map(([k, l], i) => <button role="tab" id={`tab-${k}`} aria-controls={`panel-${k}`} aria-selected={i === 0 ? 'true' : 'false'}>{l}{k !== 'profile' && <span class="n" data-n={k}>0</span>}</button>)}
      </div>

      <section role="tabpanel" id="panel-profile" aria-labelledby="tab-profile" class="mp">
        <div class="cols">
          <div>
            <h2 class="h3">Profile</h2>
            <dl class="facts" data-profile-facts></dl>
            <div class="row">
              <button type="button" class="btn secondary" data-edit-profile>Edit profile</button>
            </div>
            <h3 class="sub">Sectors</h3>
            <ul class="links" data-my-sectors></ul>
          </div>
          <div class="minimap" data-map-profile role="region" aria-label="Map of your city"></div>
        </div>
        <div class="move">
          <h3 class="sub">Workspace</h3>
          <div class="row">
            <button type="button" class="btn secondary" data-export>Export</button>
            <label class="btn secondary file">Import <input type="file" accept="application/json,.json" data-import /></label>
            <button type="button" class="btn secondary danger" data-reset>Clear</button>
          </div>
        </div>
      </section>

      <section role="tabpanel" id="panel-contrib" aria-labelledby="tab-contrib" hidden class="mp">
        <div class="stats" data-stats></div>
        <div class="cols">
          <div class="feed" data-my-posts></div>
          <div class="minimap tall" data-map-contrib role="region" aria-label="Map of your posts and your city"></div>
        </div>
      </section>

      <section role="tabpanel" id="panel-city" aria-labelledby="tab-city" hidden class="mp">
        <div class="cats" role="tablist" aria-label="My city" data-switch>
          <button role="tab" id="tab-near" aria-controls="panel-near" aria-selected="true">Research near you</button>
          <button role="tab" id="tab-tech" aria-controls="panel-tech" aria-selected="false">Technologies in our city</button>
          <button role="tab" id="tab-contacts" aria-controls="panel-contacts" aria-selected="false">Fleet emergency contacts</button>
        </div>

        <div role="tabpanel" id="panel-near" aria-labelledby="tab-near" class="sp">
          <p class="small muted" data-near-note></p>
          <ol class="near" data-near></ol>
        </div>

        <div role="tabpanel" id="panel-tech" aria-labelledby="tab-tech" hidden class="sp">
          <div class="board" data-tech-board></div>
          <form class="mini-form" data-tech-form data-astro-reload novalidate aria-labelledby="tech-h">
            <h3 id="tech-h" class="sub" data-tech-title>Add a technology</h3>
            <input type="hidden" name="id" />
            <div class="three">
              <label>Operator or technology <input name="name" maxlength="80" placeholder="For example a delivery robot pilot" /></label>
              <label>Sector <select name="sectorId" data-tsector>{sectors.map((s) => <option value={s.id}>{s.id} {s.short_name}</option>)}</select></label>
              <label>Type <select name="typeId" data-ttype></select></label>
              <label>Status <select name="status">{Object.entries(TECH_STATUS).map(([k, v]) => <option value={k}>{v}</option>)}</select></label>
              <label>Since <input type="month" name="since" /></label>
              <label>Notes <input name="notes" maxlength="280" placeholder="Permit, contract, contact desk" /></label>
            </div>
            <p class="err" role="alert" data-tech-error hidden></p>
            <div class="row"><button type="submit" class="btn">Save technology</button><button type="button" class="btn secondary" data-tech-cancel hidden>Cancel</button></div>
          </form>
        </div>

        <div role="tabpanel" id="panel-contacts" aria-labelledby="tab-contacts" hidden class="sp">
          <ul class="contacts" data-contacts></ul>
          <form class="mini-form" data-contact-form data-astro-reload novalidate aria-labelledby="contact-h">
            <h3 id="contact-h" class="sub" data-contact-title>Add a contact</h3>
            <input type="hidden" name="id" />
            <div class="three">
              <label>Operator <input name="operator" maxlength="80" placeholder="Company or agency" /></label>
              <label>Desk or role <input name="role" maxlength="80" placeholder="For example 24/7 fleet desk" /></label>
              <label>How to reach it <input name="how" maxlength="120" placeholder="Desk line, radio channel or portal" /></label>
            </div>
            <label>Notes <input name="notes" maxlength="280" placeholder="When to call, what to ask for" /></label>
            <p class="err" role="alert" data-contact-error hidden></p>
            <div class="row"><button type="submit" class="btn">Save contact</button><button type="button" class="btn secondary" data-contact-cancel hidden>Cancel</button></div>
          </form>
        </div>
      </section>

      <section role="tabpanel" id="panel-saved" aria-labelledby="tab-saved" hidden class="mp">
        <div data-saved></div>
      </section>

      <section role="tabpanel" id="panel-questions" aria-labelledby="tab-questions" hidden class="mp">
        <p class="ask"><a href={href('/share/')}>Ask a question</a></p>
        <div class="feed" data-questions></div>
      </section>
    </div>
  </div>

  <script type="application/json" data-catalog set:html={JSON.stringify(catalog())} />
  <script type="application/json" data-research set:html={JSON.stringify(points)} />
</Base>

<script>
  import { mountMy } from '../scripts/myeacp';
  let cleanup: (() => void) | undefined;
  document.addEventListener('astro:page-load', () => {
    cleanup?.();
    const root = document.querySelector<HTMLElement>('[data-my]');
    cleanup = root ? mountMy(root) : undefined;
  });
  document.addEventListener('astro:before-swap', () => { cleanup?.(); cleanup = undefined; });
</script>

<style>
  .my-head { background: var(--c-surface-alt); border-bottom: var(--border); padding: var(--sp-5) 0 var(--sp-4); }
  h1 { font-size: var(--fs-2xl); margin: 0; }
  .gate-acts { display: flex; gap: var(--sp-3); justify-content: center; flex-wrap: wrap; }
  .ask { margin: 0 0 var(--sp-3); font-weight: 600; }
  .gate { text-align: center; padding: var(--sp-7) var(--sp-4); background: var(--c-surface-alt); border-radius: var(--radius-md); }
  .gate[hidden], [data-workspace][hidden], .setup[hidden] { display: none; }
  .setup, .mini-form { display: grid; gap: var(--sp-4); max-width: 52rem; }
  .setup { background: #fff; border: var(--border); border-radius: var(--radius-md); padding: var(--sp-5); }
  .setup h2 { font-size: var(--fs-xl); margin: 0; }
  label { display: grid; grid-template-columns: auto 1fr; align-items: baseline; gap: 4px 0.4rem; font-weight: 600; font-size: var(--fs-sm); color: var(--c-ink); }
  label > input:not([type='checkbox']):not([type='file']), label > select { grid-column: 1 / -1; }
  label > .muted { font-weight: 500; }
  input:not([type='checkbox']):not([type='file']), select { font: 400 var(--fs-md) var(--font-sans); color: var(--c-ink); border: 1.5px solid #8f9cb0; border-radius: var(--radius-sm); padding: 0.55rem 0.7rem; background: #fff; width: 100%; min-height: 44px; }
  .combo { position: relative; display: grid; gap: 4px; }
  .combo label { display: block; }
  [data-city-list] { position: absolute; z-index: 20; top: 4.6rem; left: 0; right: 0; list-style: none; margin: 0; padding: 4px; background: #fff; border: var(--border); border-radius: var(--radius-md); box-shadow: var(--shadow-panel); max-height: 18rem; overflow: auto; }
  [data-city-list] :global(li) { padding: 0.55rem 0.7rem; border-radius: var(--radius-sm); cursor: pointer; font-size: var(--fs-sm); }
  [data-city-list] :global(li[aria-selected='true']), [data-city-list] :global(li:hover) { background: var(--c-selected); color: #fff; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-3); }
  .three { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--sp-3); }
  @media (max-width: 760px) { .two, .three { grid-template-columns: 1fr; } }
  .secs { border: 0; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .secs legend { font-weight: 600; font-size: var(--fs-sm); margin-bottom: var(--sp-2); padding: 0; }
  .check { display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 500; padding: 0.4rem 0.75rem; border: 1.5px solid var(--c-line); border-radius: var(--radius-pill); cursor: pointer; min-height: 38px; }
  .check:has(input:checked) { background: #e8f1fb; border-color: var(--c-medium); }
  .row { display: flex; gap: var(--sp-3); flex-wrap: wrap; align-items: center; }
  .row [hidden] { display: none; }
  .err { color: #a3001b; font-weight: 600; margin: 0; }

  .card-id { margin-bottom: var(--sp-5); }
  .card-id :global(.idc) { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--sp-1) var(--sp-4); border-bottom: var(--border); padding-bottom: var(--sp-4); }
  .card-id :global(.city) { font: 700 var(--fs-xl) var(--font-serif); color: var(--c-ink); margin: 0; }
  .card-id :global(.role) { margin: 0; color: var(--c-muted); font-size: var(--fs-sm); }

  .mp { margin-top: var(--sp-5); }
  .sp { margin-top: var(--sp-4); }
  .h3 { font-size: var(--fs-xl); }
  .sub { font: 700 var(--fs-md) var(--font-sans); color: var(--c-ink); margin: var(--sp-5) 0 var(--sp-2); }
  .cols { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(16rem, 1fr); gap: var(--sp-5); align-items: start; }
  @media (max-width: 860px) { .cols { grid-template-columns: 1fr; } }
  .minimap { height: 300px; border-radius: var(--radius-md); overflow: hidden; border: var(--border); background: #cfe3f5; }
  .minimap.tall { height: 420px; position: sticky; top: calc(var(--header-h) + 1rem); }
  .links { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .links :global(a) { display: inline-flex; align-items: center; min-height: 36px; padding: 0 0.85rem; border-radius: var(--radius-pill); background: #e8f1fb; color: var(--c-heritage); font-weight: 600; font-size: var(--fs-sm); text-decoration: none; }
  .links :global(a:hover) { background: var(--c-heritage); color: #fff; }
  .move { margin-top: var(--sp-6); border-top: var(--border); padding-top: var(--sp-2); }
  .file { position: relative; display: inline-flex; overflow: hidden; }
  .file input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .file:focus-within { outline: 3px solid var(--c-focus); outline-offset: 2px; }
  .danger { color: #8a0016; border-color: #8a0016; }
  .stats { display: flex; gap: var(--sp-3); flex-wrap: wrap; margin-bottom: var(--sp-4); }
  .stats :global(.st) { background: var(--c-surface-alt); border-radius: var(--radius-md); padding: var(--sp-3) var(--sp-4); min-width: 9rem; }
  .stats :global(.st b) { display: block; font: 700 var(--fs-xl) var(--font-serif); color: var(--c-heritage); }
  .stats :global(.st span) { font-size: var(--fs-xs); color: var(--c-muted); }
  .feed { display: grid; gap: var(--sp-4); }
  .feed :global(.none), [data-saved] :global(.none), .board :global(.none), .contacts :global(.none), .near :global(.none) { background: var(--c-surface-alt); border-radius: var(--radius-md); padding: var(--sp-5); text-align: center; color: var(--c-muted); list-style: none; }
  .near { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--sp-2); }
  .near :global(li) { display: grid; grid-template-columns: 5.5rem 1fr; gap: var(--sp-3); align-items: start; background: #fff; border: var(--border); border-radius: var(--radius-md); padding: var(--sp-3) var(--sp-4); }
  .near :global(.km) { font: 700 var(--fs-md) var(--font-serif); color: var(--c-heritage); }
  .near :global(.km small) { display: block; font: 500 var(--fs-xs) var(--font-sans); color: var(--c-muted); }
  .near :global(p) { margin: 2px 0 0; font-size: var(--fs-sm); }
  .near :global(.d) { font-size: var(--fs-xs); color: var(--c-muted); }
  /* Technology board: a column per status */
  .board { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: var(--sp-2); margin-bottom: var(--sp-5); }
  @media (max-width: 960px) { .board { grid-template-columns: 1fr 1fr; } }
  .board :global(.col) { background: var(--c-surface-alt); border-radius: var(--radius-md); padding: var(--sp-3); min-height: 8rem; }
  .board :global(.col h4) { font: 700 var(--fs-xs) var(--font-sans); color: var(--c-ink); margin: 0 0 var(--sp-2); display: flex; justify-content: space-between; }
  .board :global(.col.paused h4), .board :global(.col.banned h4) { color: #8a0016; }
  .board :global(.tcard) { background: #fff; border-radius: var(--radius-sm); padding: var(--sp-2) var(--sp-3); margin-bottom: var(--sp-2); font-size: var(--fs-sm); box-shadow: 0 1px 2px rgb(0 45 114 / 0.08); }
  .board :global(.tcard strong) { display: block; }
  .board :global(.tcard .d) { font-size: var(--fs-xs); color: var(--c-muted); }
  .board :global(.none) { grid-column: 1 / -1; }
  .contacts { list-style: none; padding: 0; margin: 0 0 var(--sp-5); display: grid; gap: var(--sp-2); }
  .contacts :global(li:not(.none)) { background: #fff; border: var(--border); border-left: 5px solid var(--c-heritage); border-radius: var(--radius-md); padding: var(--sp-3) var(--sp-4); }
  .contacts :global(strong) { display: block; }
  .contacts :global(p) { margin: 2px 0; font-size: var(--fs-sm); }
  :global(.mini-acts) { display: flex; gap: var(--sp-3); }
  :global(.mini-acts button) { font: 600 var(--fs-xs) var(--font-sans); color: var(--c-link); background: none; border: 0; padding: 0.3rem 0; min-height: 30px; text-decoration: underline; cursor: pointer; }
  [data-saved] :global(h3) { font: 700 var(--fs-md) var(--font-sans); margin: var(--sp-4) 0 var(--sp-2); }
  [data-saved] :global(ul) { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--sp-2); }
  [data-saved] :global(li) { display: flex; justify-content: space-between; align-items: center; gap: var(--sp-3); background: #fff; border: var(--border); border-radius: var(--radius-md); padding: var(--sp-2) var(--sp-4); }
  [data-saved] :global(li .d) { display: block; font-size: var(--fs-xs); color: var(--c-muted); }
  :global(.mypin) { width: 18px; height: 18px; background: #fff; border: 4px solid var(--c-shared); border-radius: 3px; box-shadow: 0 1px 4px rgb(0 29 74 / 0.4); }
  :global(.citypin) { width: 22px; height: 22px; background: var(--c-gold); border: 4px solid var(--c-heritage); border-radius: 50%; box-shadow: 0 1px 4px rgb(0 29 74 / 0.4); }
</style>
