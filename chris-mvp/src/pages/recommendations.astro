---
/** Recommendations became the Toolkit (the team's proposals are tools there). This page only redirects. */
import { href } from '../lib/url';
const to = href('/toolkit/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={to} />
    <title>Moved to the Toolkit</title>
  </head>
  <body>
    <main><h1>Recommendations moved</h1><p><a href={to}>Open the Toolkit</a>.</p></main>
  </body>
</html>
