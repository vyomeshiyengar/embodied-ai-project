---
/** Moved: "See it in action", "Types" and "In the city" are now part of the Overview. Keeps #<type id> links working. */
import { sectors, type Sector } from '../../../lib/content';
import { sectorHref } from '../../../lib/url';
export function getStaticPaths() {
  return sectors.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props as { s: Sector };
const to = sectorHref(s.slug);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={to} />
    <title>Moved to the Overview</title>
    <script is:inline define:vars={{ to }}>location.replace(to + location.hash);</script>
  </head>
  <body>
    <main><h1>This page moved</h1><p><a href={to}>Open {s.name} in the city</a>.</p></main>
  </body>
</html>
