---
/** "Choose a sector" moved to /playbook/. This page only redirects there (vercel.json also redirects). */
import { href } from '../lib/url';
const to = href('/playbook/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={to} />
    <title>Moved to the Playbook</title>
  </head>
  <body>
    <main><h1>This page moved</h1><p><a href={to}>Open the Playbook</a>.</p></main>
  </body>
</html>
