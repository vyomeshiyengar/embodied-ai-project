---
/**
 * Share: a city-to-city exchange. "Share a use case" is a five-step composer (any place on Earth);
 * "From other cities" is the feed of posts on this device plus any opened from share links.
 * Demo only: posts live in this browser, travel by share link, and are always labeled unverified.
 * Logic in src/scripts/share.ts. Nothing is seeded.
 */
import Base from '../layouts/Base.astro';
import { sectors } from '../lib/content';
import { catalog } from '../lib/catalog';
import { mapPoints } from '../lib/map-points';
import { POST_KINDS, OUTCOMES } from '../lib/workspace-store';
import { href } from '../lib/url';
import '../styles/posts.css';

const KIND_ICON: Record<string, string> = {
  worked: 'M5 12.5l4.2 4.2L19 7',
  wrong: 'M12 4l9 16H3zM12 10v4M12 17v.5',
  near_miss: 'M3 13a9 9 0 0 1 18 0M7 13a5 5 0 0 1 10 0M12 13v.5',
  rule_change: 'M6 3h9l3 3v15H6zM9 9h6M9 13h6M9 17h4',
  question: 'M9 9a3 3 0 1 1 4.2 2.8c-.8.4-1.2 1-1.2 1.8V15M12 18.5v.5',
  tip: 'M9 18h6M10 21h4M12 3a6 6 0 0 0-4 10.5c.6.6 1 1.4 1 2.5h6c0-1.1.4-1.9 1-2.5A6 6 0 0 0 12 3z',
};
const STEPS = ['Where', 'What kind', 'Technology', 'The story', 'Review'];
const points = mapPoints().map((p) => ({ id: p.id, sectorId: p.sectorId, place: p.place, lat: p.lat, lng: p.lng, what: p.what, caseTitle: p.caseTitle, sources: p.sources.slice(0, 1), asOf: p.asOf }));
---
<Base title="Share" description="Swap lessons about robots, drones and driverless vehicles with other cities.">
  <div class="share-head">
    <div class="container">
      <h1>Share</h1>
      <div class="cats big" role="tablist" aria-label="Share" data-switch data-share-tabs>
        <button role="tab" id="tab-compose" aria-controls="panel-compose" aria-selected="true">Share a use case</button>
        <button role="tab" id="tab-feed" aria-controls="panel-feed" aria-selected="false">From other cities <span class="n" data-feed-count>0</span></button>
      </div>
    </div>
  </div>

  <div class="container page">
    <p class="visually-hidden" aria-live="polite" data-announce></p>

    <!-- ===== Composer ===== -->
    <section role="tabpanel" id="panel-compose" aria-labelledby="tab-compose" data-compose>
      <div class="gate" data-gate>
        <h2>Sign in to share</h2>
        <div class="gate-acts">
          <button type="button" class="btn" data-signin-open>Sign in</button>
          <a class="btn secondary" href={href('/playbook/')}>Continue browsing</a>
        </div>
      </div>

      <div data-composer hidden>
        <ol class="progress" aria-label="Steps">
          {STEPS.map((l, i) => <li data-pstep={i}><span class="pn num" aria-hidden="true">{i + 1}</span><span class="pl">{l}</span></li>)}
        </ol>

        <form class="composer" data-compose-form data-astro-reload novalidate aria-describedby="compose-status">
          <p class="visually-hidden" id="compose-status" aria-live="polite" data-step-status></p>

          <fieldset class="step" data-step="0">
            <legend><span class="num">1</span> Where did it happen?</legend>
            <div class="where">
              <div class="where-form">
                <div class="combo">
                  <label for="city-q">City</label>
                  <input id="city-q" type="text" autocomplete="off" role="combobox" aria-controls="city-list" aria-expanded="false" aria-autocomplete="list" placeholder="Search a city, or click the map" data-city-input />
                  <ul id="city-list" role="listbox" aria-label="Cities" hidden data-city-list></ul>
                  <p class="small muted" aria-live="polite" data-city-status></p>
                </div>
                <div class="coords">
                  <label>Latitude <input name="lat" inputmode="decimal" data-lat /></label>
                  <label>Longitude <input name="lng" inputmode="decimal" data-lng /></label>
                  <button type="button" class="btn secondary small" data-coords-go>Place pin</button>
                </div>
                <label>Place name <input name="place" maxlength="120" data-place-name placeholder="City, district or site" /></label>
              </div>
              <div class="where-map">
                <div class="mapbox" data-compose-map role="region" aria-label="Map: click to drop a pin, drag to adjust"></div>
                <p class="pinstat small" aria-live="polite" data-pin-status>No pin yet.</p>
              </div>
            </div>
          </fieldset>

          <fieldset class="step" data-step="1" hidden>
            <legend><span class="num">2</span> What kind of post is it?</legend>
            <div class="kinds">
              {Object.entries(POST_KINDS).map(([k, v]) => (
                <label class="kindcard">
                  <input type="radio" name="kind" value={k} />
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d={KIND_ICON[k]} /></svg>
                  <span class="kl">{v.label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset class="step" data-step="2" hidden>
            <legend><span class="num">3</span> Which technology?</legend>
            <label>Sector
              <select name="sector" data-sector-select>
                <option value="">Choose a sector</option>
                {sectors.map((s) => <option value={s.id}>{s.id} {s.name}</option>)}
              </select>
            </label>
            <label>Type of technology <span class="muted">(optional)</span>
              <select name="type" data-type-select disabled><option value="">Choose a sector first</option></select>
            </label>
            <label>Related risk <span class="muted">(optional)</span>
              <select name="risk" data-risk-select disabled><option value="">Choose a sector first</option></select>
            </label>
          </fieldset>

          <fieldset class="step" data-step="3" hidden>
            <legend><span class="num">4</span> The story</legend>
            <label>When <span class="muted">(optional)</span> <input type="month" name="when" min="2000-01" /></label>
            <label><span data-text-label>What happened</span> <span class="muted" data-count-for="text">0 of 500</span>
              <textarea name="text" maxlength="500" rows="5" data-counted></textarea>
            </label>
            <label><span data-lesson-label>What would you tell another city?</span> <span class="muted" data-count-for="lesson">0 of 280</span>
              <textarea name="lesson" maxlength="280" rows="3" data-counted></textarea>
            </label>
            <label>Link to this use case <span class="muted">(article or official page)</span>
              <input name="link" type="url" placeholder="https://" required aria-required="true" />
            </label>
            <fieldset class="mediabox">
              <legend>Photo or video <span class="muted">(optional)</span></legend>
              <div class="mtabs" role="radiogroup" aria-label="Add media from">
                <label class="check"><input type="radio" name="mediaFrom" value="link" checked /> Link</label>
                <label class="check"><input type="radio" name="mediaFrom" value="upload" /> Upload a photo</label>
              </div>
              <div class="mfrom" data-media-link>
                <label>Image, YouTube or Vimeo link <input name="mediaUrl" type="url" placeholder="https://" data-media-url /></label>
                <label>Describe the image <span class="muted">(for people who can't see it)</span> <input name="mediaAlt" maxlength="200" /></label>
              </div>
              <div class="mfrom" data-media-upload hidden>
                <label>Photo <input name="mediaFile" type="file" accept="image/*" data-media-file /></label>
                <label>Describe the photo <input name="mediaFileAlt" maxlength="200" /></label>
                <p class="small muted">Saved on this device only. Share links don't include it.</p>
              </div>
              <div class="mpreview" data-media-preview></div>
            </fieldset>
            <fieldset class="outs">
              <legend>What changed <span class="muted">(optional)</span></legend>
              {OUTCOMES.map((o) => <label class="check"><input type="checkbox" name="outcomes" value={o} /> {o}</label>)}
            </fieldset>
          </fieldset>

          <fieldset class="step" data-step="4" hidden>
            <legend><span class="num">5</span> Review</legend>
            <div class="review">
              <div>
                <h3 class="rh">Your post</h3>
                <div data-preview></div>
              </div>
              <aside class="similar" aria-labelledby="sim-h">
                <h3 class="rh" id="sim-h">Related research</h3>
                <div data-similar></div>
              </aside>
            </div>
          </fieldset>

          <p class="err" role="alert" data-compose-error hidden></p>
          <div class="nav">
            <button type="button" class="btn secondary" data-back hidden>Back</button>
            <button type="button" class="btn" data-next>Next</button>
            <button type="submit" class="btn" data-publish hidden>Publish to my map</button>
          </div>
        </form>

        <div class="posted" data-done hidden tabindex="-1">
          <h2>Posted to your map</h2>
          <p>It is saved in this browser. Copy the link to send it to another city.</p>
          <div class="done-acts">
            <button type="button" class="btn" data-done-copy>Copy share link</button>
            <a class="btn secondary" data-done-map href={href('/map/')}>See it on the map</a>
            <button type="button" class="btn secondary" data-done-feed>See it in the feed</button>
            <button type="button" class="btn secondary" data-done-again>Share another</button>
          </div>
          <div data-done-link></div>
        </div>
      </div>
    </section>

    <!-- ===== Feed ===== -->
    <section role="tabpanel" id="panel-feed" aria-labelledby="tab-feed" hidden data-feed>
      <div class="incoming" data-incoming hidden tabindex="-1"></div>
      <div class="filters" role="group" aria-label="Filter posts">
        <div class="kchips" role="group" aria-label="Kind of post">
          <button type="button" aria-pressed="true" data-fkind="">All</button>
          {Object.entries(POST_KINDS).map(([k, v]) => <button type="button" aria-pressed="false" data-fkind={k}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={KIND_ICON[k]} /></svg>{v.short}</button>)}
        </div>
        <div class="fsel">
          <label>Sector <select data-fsector><option value="">All sectors</option>{sectors.map((s) => <option value={s.id}>{s.id} {s.short_name}</option>)}</select></label>
          <label>Technology <select data-ftype disabled><option value="">All technologies</option></select></label>
          <label>City <input type="search" data-fcity placeholder="Any city" /></label>
        </div>
      </div>
      <p class="fcount small muted" aria-live="polite" data-fcount></p>
      <div class="feed" data-feed-list></div>
      <div class="empty" data-feed-empty hidden>
        <h2>No use cases shared yet</h2>
        <button type="button" class="btn" data-activate="tab-compose">Share a use case</button>
      </div>
    </section>
  </div>

  <script type="application/json" data-catalog set:html={JSON.stringify(catalog())} />
  <script type="application/json" data-research set:html={JSON.stringify(points)} />
</Base>

<script>
  import { mountShare } from '../scripts/share';
  let cleanup: (() => void) | undefined;
  document.addEventListener('astro:page-load', () => {
    cleanup?.();
    const root = document.querySelector<HTMLElement>('[data-compose]')?.closest<HTMLElement>('.page');
    cleanup = root ? mountShare(root) : undefined;
  });
  document.addEventListener('astro:before-swap', () => { cleanup?.(); cleanup = undefined; });
</script>

<style>
  .share-head { background: var(--c-surface-alt); border-bottom: var(--border); padding: var(--sp-5) 0 var(--sp-4); }
  h1 { font-size: var(--fs-2xl); margin: 0 0 var(--sp-4); }
  .gate { text-align: center; padding: var(--sp-7) var(--sp-4); background: var(--c-surface-alt); border-radius: var(--radius-md); }
  .gate h2 { font-size: var(--fs-xl); }
  .gate-acts { display: flex; gap: var(--sp-3); justify-content: center; flex-wrap: wrap; }
  .gate[hidden] { display: none; }

  .progress { display: flex; list-style: none; padding: 0; margin: 0 0 var(--sp-5); gap: 4px; }
  .progress li { flex: 1; display: flex; align-items: center; gap: 0.5rem; padding: var(--sp-2) 0; border-bottom: 4px solid var(--c-line); color: var(--c-muted); font-weight: 600; font-size: var(--fs-sm); transition: border-color var(--dur-med) var(--ease), color var(--dur-med) var(--ease); }
  .progress .pn { width: 1.6rem; height: 1.6rem; flex: none; border-radius: 50%; display: grid; place-items: center; border: 1.5px solid var(--c-line); background: #fff; font-size: var(--fs-xs); }
  .progress li.done { border-color: var(--c-spirit); color: var(--c-ink); }
  .progress li.done .pn { background: var(--c-spirit); border-color: var(--c-spirit); color: var(--c-heritage-deep); }
  .progress li.now { border-color: var(--c-heritage); color: var(--c-heritage); }
  .progress li.now .pn { background: var(--c-heritage); border-color: var(--c-heritage); color: #fff; }
  @media (max-width: 640px) { .progress .pl { display: none; } .progress li.now .pl { display: inline; } }

  .composer { display: grid; gap: var(--sp-4); }
  .step { border: 0; padding: 0; margin: 0; min-width: 0; display: grid; gap: var(--sp-4); }
  .step[hidden] { display: none; }
  .step.enter { animation: panel-in var(--dur-panel) var(--ease-out) both; }
  .step.enter.from-left { animation-name: panel-in-left; }
  .step > legend { font: 700 var(--fs-xl) var(--font-serif); color: var(--c-ink); margin-bottom: var(--sp-3); padding: 0; display: flex; gap: 0.6rem; align-items: center; }
  .step > legend .num { width: 2rem; height: 2rem; border-radius: 50%; background: var(--c-heritage); color: #fff; display: grid; place-items: center; font: 700 var(--fs-sm) var(--font-sans); }
  label { display: grid; grid-template-columns: auto 1fr; align-items: baseline; gap: 4px 0.4rem; font-weight: 600; font-size: var(--fs-sm); color: var(--c-ink); }
  label > input:not([type='radio']):not([type='checkbox']), label > select, label > textarea { grid-column: 1 / -1; }
  label > .muted { font-weight: 500; }
  input:not([type='radio']):not([type='checkbox']), select, textarea { font: 400 var(--fs-md) var(--font-sans); color: var(--c-ink); border: 1.5px solid #8f9cb0; border-radius: var(--radius-sm); padding: 0.55rem 0.7rem; background: #fff; width: 100%; min-height: 44px; }
  input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 3px solid var(--c-focus); outline-offset: 1px; }
  select:disabled { background: var(--c-surface-alt); color: var(--c-muted); }

  .where { display: grid; grid-template-columns: minmax(16rem, 22rem) 1fr; gap: var(--sp-5); align-items: start; }
  @media (max-width: 860px) { .where { grid-template-columns: 1fr; } }
  .where-form { display: grid; gap: var(--sp-4); }
  .combo { position: relative; display: grid; gap: 4px; }
  .combo label { display: block; }
  [data-city-list] { position: absolute; z-index: 20; top: 4.6rem; left: 0; right: 0; list-style: none; margin: 0; padding: 4px; background: #fff; border: var(--border); border-radius: var(--radius-md); box-shadow: var(--shadow-panel); max-height: 18rem; overflow: auto; }
  [data-city-list] :global(li) { padding: 0.55rem 0.7rem; border-radius: var(--radius-sm); cursor: pointer; font-size: var(--fs-sm); }
  [data-city-list] :global(li[aria-selected='true']), [data-city-list] :global(li:hover) { background: var(--c-selected); color: #fff; }
  .coords { display: grid; grid-template-columns: 1fr 1fr auto; gap: var(--sp-2); align-items: end; }
  .where-map { display: grid; gap: var(--sp-2); }
  .mapbox { height: 380px; border-radius: var(--radius-md); overflow: hidden; border: var(--border); background: #cfe3f5; }
  .pinstat { margin: 0; color: var(--c-muted); }
  :global(.draft-pin.pulse) { animation: pin-pulse 1.4s ease-out infinite; }
  @keyframes pin-pulse { 0% { box-shadow: 0 0 0 0 rgb(122 79 0 / 0.55), 0 2px 6px rgb(0 0 0 / 0.3); } 100% { box-shadow: 0 0 0 16px rgb(122 79 0 / 0), 0 2px 6px rgb(0 0 0 / 0.3); } }
  :global(html[data-motion='reduce'] .draft-pin.pulse) { animation: none; }
  @media (prefers-reduced-motion: reduce) { :global(html:not([data-motion='full']) .draft-pin.pulse) { animation: none; } }
  :global(.draft-pin) { width: 26px; height: 26px; border-radius: 50% 50% 50% 0; transform: rotate(-45deg); background: var(--c-shared); border: 3px solid #fff; box-shadow: 0 2px 6px rgb(0 0 0 / 0.3); cursor: grab; }

  .kinds { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr)); gap: var(--sp-3); }
  .kindcard { position: relative; display: grid; grid-template-columns: auto 1fr; column-gap: var(--sp-3); align-items: center; padding: var(--sp-4); border: 2px solid var(--c-line); border-radius: var(--radius-md); background: #fff; cursor: pointer; transition: border-color var(--dur-fast) var(--ease), background-color var(--dur-fast) var(--ease), transform var(--dur-med) var(--ease-out); }
  .kindcard:hover { border-color: var(--c-medium); transform: translateY(-2px); }
  .kindcard input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .kindcard svg { width: 30px; height: 30px; fill: none; stroke: var(--c-heritage); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .kl { font-size: var(--fs-md); font-weight: 700; }
  .kindcard:has(input:checked) { border-color: var(--c-selected); background: var(--c-selected); color: #fff; }
  .kindcard:has(input:checked) svg { stroke: #fff; }
  .kindcard:has(input:focus-visible) { outline: 3px solid var(--c-focus); outline-offset: 2px; }

  .mediabox { border: 1px solid var(--c-line); border-radius: var(--radius-md); padding: var(--sp-4); margin: 0; display: grid; gap: var(--sp-3); min-width: 0; }
  .mediabox legend { font-weight: 600; font-size: var(--fs-sm); padding: 0 4px; }
  .mtabs { display: flex; gap: 6px; flex-wrap: wrap; }
  .mfrom { display: grid; gap: var(--sp-3); grid-template-columns: 1fr 1fr; align-items: end; }
  .mfrom[hidden] { display: none; }
  .mfrom p { grid-column: 1 / -1; margin: 0; }
  @media (max-width: 700px) { .mfrom { grid-template-columns: 1fr; } }
  .mpreview :global(img), .mpreview :global(iframe) { max-width: 22rem; width: 100%; border-radius: calc(var(--radius-md) - 6px); }
  .outs { border: 0; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .outs legend { font-weight: 600; font-size: var(--fs-sm); margin-bottom: var(--sp-2); padding: 0; }
  .check { display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 500; padding: 0.4rem 0.75rem; border: 1.5px solid var(--c-line); border-radius: var(--radius-pill); cursor: pointer; min-height: 38px; }
  .check:has(input:checked) { background: #e8f1fb; border-color: var(--c-medium); }

  .review { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(16rem, 1fr); gap: var(--sp-5); align-items: start; }
  @media (max-width: 860px) { .review { grid-template-columns: 1fr; } }
  .rh { font: 700 var(--fs-sm) var(--font-sans); color: var(--c-muted); margin-bottom: var(--sp-2); }
  .similar { background: var(--c-surface-alt); border-radius: var(--radius-md); padding: var(--sp-4); }
  .similar :global(.sim) { background: #fff; border-radius: var(--radius-sm); padding: var(--sp-3); margin-top: var(--sp-2); font-size: var(--fs-sm); }
  .similar :global(.sim strong) { display: block; }
  .similar :global(.sim p) { margin: 4px 0; }
  .similar :global(.sim .d) { font-size: var(--fs-xs); color: var(--c-muted); }

  .err { color: #a3001b; font-weight: 600; margin: 0; }
  .nav { display: flex; gap: var(--sp-3); justify-content: flex-end; border-top: var(--border); padding-top: var(--sp-4); }
  .nav [hidden] { display: none; }
  .posted { text-align: center; padding: var(--sp-6) var(--sp-4); background: var(--c-surface-alt); border-radius: var(--radius-md); }
  .posted h2 { font-size: var(--fs-xl); }
  .done-acts { display: flex; gap: var(--sp-3); justify-content: center; flex-wrap: wrap; margin-top: var(--sp-4); }
  .posted[hidden] { display: none; }

  .filters { display: grid; gap: var(--sp-3); margin-bottom: var(--sp-3); }
  .kchips { display: flex; flex-wrap: wrap; gap: 6px; }
  .kchips button { display: inline-flex; align-items: center; gap: 0.35rem; font: 600 var(--fs-xs) var(--font-sans); color: var(--c-ink); background: var(--c-surface-alt); border: 0; border-radius: var(--radius-pill); padding: 0 0.85rem; min-height: 36px; cursor: pointer; }
  .kchips svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .kchips button[aria-pressed='true'] { background: var(--c-selected); color: #fff; }
  .fsel { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--sp-3); }
  @media (max-width: 700px) { .fsel { grid-template-columns: 1fr; } }
  .feed { display: grid; gap: var(--sp-4); }
  .empty { text-align: center; padding: var(--sp-7) var(--sp-4); background: var(--c-surface-alt); border-radius: var(--radius-md); }
  .empty[hidden] { display: none; }
  .incoming { border: 2px solid var(--c-shared); border-radius: var(--radius-md); padding: var(--sp-4); margin-bottom: var(--sp-5); background: var(--c-shared-bg); }
  .incoming[hidden] { display: none; }
  .incoming :global(h2) { font-size: var(--fs-xl); margin: 0 0 var(--sp-2); }
  .incoming :global(.done-acts) { display: flex; gap: var(--sp-3); flex-wrap: wrap; margin-top: var(--sp-4); }
  .posted :global(.manual), .incoming :global(.manual) { display: grid; gap: 4px; max-width: 40rem; margin: var(--sp-4) auto 0; text-align: left; }
</style>
