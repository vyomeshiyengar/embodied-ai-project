---
import { ClientRouter } from 'astro:transitions';
import '../styles/base.css';
import SignIn from '../components/SignIn.astro';
import Wordmark from '../components/Wordmark.astro';
import { href } from '../lib/url';
import { SITE_NAME, SITE_DESCRIPTION } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  /** Current sector slug, if on a sector page. */
  sector?: string;
  /** Sub-page of the sector (e.g. "risks"). Kept for the sector switcher in SectorFlow. */
  sectorPage?: string;
  /** Story and map pages run edge to edge, without the footer. */
  bare?: boolean;
  /** Welcome page: no header, no footer. */
  welcome?: boolean;
}
const { title, description = SITE_DESCRIPTION, sector, bare = false, welcome = false } = Astro.props;
const path = Astro.url.pathname;
const under = (p: string) => path.startsWith(href(p));
const primary = [
  { label: 'Playbook', href: href('/playbook/'), on: under('/playbook/') || under('/sectors/') || !!sector },
  { label: 'Map', href: href('/map/'), on: under('/map/') },
  { label: 'Share', href: href('/share/'), on: under('/share/') },
  { label: 'MyEACP', href: href('/myeacp/'), on: under('/myeacp/') },
];
const more = [
  { label: 'Glossary', href: href('/glossary/') },
  { label: 'Recommendations', href: href('/recommendations/') },
  { label: 'About', href: href('/about/') },
];
const pageTitle = title === SITE_NAME ? SITE_NAME : `${title} | ${SITE_NAME}`;

// Slide animations (keyframes in base.css). "Back" links and browser Back slide the other way.
const ms = 'var(--dur-page)';
const ease = 'cubic-bezier(0.16, 1, 0.3, 1)';
const pageAnim = {
  forwards: {
    old: { name: 'page-out-left', duration: ms, easing: ease, fillMode: 'both' },
    new: { name: 'page-in-right', duration: ms, easing: ease, fillMode: 'both' },
  },
  backwards: {
    old: { name: 'page-out-right', duration: ms, easing: ease, fillMode: 'both' },
    new: { name: 'page-in-left', duration: ms, easing: ease, fillMode: 'both' },
  },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <script is:inline data-astro-rerun>
      // Apply the saved motion preference before paint (and again after each page swap).
      try { const m = localStorage.getItem('eacp-motion'); if (m) document.documentElement.dataset.motion = m; } catch (e) {}
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body class:list={[{ bare, welcome }]}>
    <a class="skip-link" href="#main">Skip to content</a>
    {!welcome && (
      <header class="site" transition:name="site-header" transition:animate="none">
        <div class="bar container">
          <a class="brand" href={href('/')} data-nav-dir="back"><Wordmark /></a>
          <nav class="primary" aria-label="Main">
            <ul>
              {primary.map((n) => <li><a class="navlink" href={n.href} aria-current={n.on ? 'page' : undefined}>{n.label}</a></li>)}
            </ul>
          </nav>
          <div class="util">
            <details class="menu more">
              <summary>More</summary>
              <ul>{more.map((n) => <li><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>)}</ul>
            </details>
            <button class="signin" type="button" data-signin-open>Sign in</button>
            <span class="signed" data-signed hidden>
              <span class="who" data-who>Signed in (demo)</span>
              <button type="button" class="linkish" data-signout>Sign out</button>
            </span>
            <button class="motion" type="button" aria-pressed="false" data-motion-toggle>Reduce motion</button>
          </div>
        </div>
      </header>
    )}
    <main id="main" tabindex="-1" transition:name="page" transition:animate={pageAnim}>
      <slot />
    </main>
    {!welcome && !bare && (
      <footer class="site">
        <div class="container foot">
          <p>{SITE_NAME} is a student prototype by a Carnegie Mellon Heinz College team for the Bloomberg Center for Government Excellence (GovEx) at Johns Hopkins. It is not an official GovEx or Johns Hopkins product. <a href={href('/about/')}>Sources, dates and AI use</a>.</p>
        </div>
      </footer>
    )}
    <SignIn />
    <script>
      import { initSwitchers, bindSwitcherResize, openFromHash } from '../scripts/switcher';
      import { getSession, signOut } from '../lib/demo-auth';
      import { ws, CHANGE_EVENT } from '../lib/workspace-store';
      import { initSaveButtons } from '../scripts/save-buttons';
      import { initEdgeFades } from '../scripts/edge-fade';

      const root = document.documentElement;
      const reduced = () => root.dataset.motion === 'reduce' || (root.dataset.motion !== 'full' && matchMedia('(prefers-reduced-motion: reduce)').matches);

      function syncAuth() {
        const s = getSession();
        document.querySelectorAll<HTMLElement>('[data-signin-open]').forEach((b) => (b.hidden = !!s));
        document.querySelectorAll<HTMLElement>('[data-signed]').forEach((b) => (b.hidden = !s));
        const city = s ? ws.profile()?.city.name : undefined;
        document.querySelectorAll<HTMLElement>('[data-who]').forEach((w) => (w.textContent = city ? `${city} (demo)` : 'Signed in (demo)'));
        document.documentElement.dataset.signedIn = s ? '1' : '';
        document.querySelectorAll<HTMLElement>('[data-guest]').forEach((g) => (g.textContent = s ? 'Continue' : 'Continue as guest'));
      }

      function initChrome() {
        const btn = document.querySelector<HTMLButtonElement>('[data-motion-toggle]');
        const syncMotion = () => btn?.setAttribute('aria-pressed', String(reduced()));
        if (btn && !btn.dataset.ready) {
          btn.dataset.ready = '1';
          btn.addEventListener('click', () => {
            root.dataset.motion = reduced() ? 'full' : 'reduce';
            try { localStorage.setItem('eacp-motion', root.dataset.motion); } catch (e) {}
            syncMotion();
            window.dispatchEvent(new CustomEvent('eacp-motion-change'));
          });
        }
        syncMotion();
        const menus = [...document.querySelectorAll<HTMLDetailsElement>('header.site details, details.switch')];
        menus.forEach((m) => m.addEventListener('toggle', () => { if (m.open) menus.forEach((o) => o !== m && (o.open = false)); }));
        document.querySelectorAll<HTMLElement>('[data-signout]').forEach((b) => {
          if (b.dataset.ready) return;
          b.dataset.ready = '1';
          b.addEventListener('click', () => signOut());
        });
        syncAuth();
        initSwitchers();
        bindSwitcherResize();
        initSaveButtons();
        initEdgeFades();
        openFromHash();
      }

      document.addEventListener('click', (e) => {
        document.querySelectorAll<HTMLDetailsElement>('header.site details[open], details.switch[open]').forEach((m) => { if (!m.contains(e.target as Node)) m.open = false; });
      });
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        document.querySelectorAll<HTMLDetailsElement>('header.site details[open], details.switch[open]').forEach((m) => { m.open = false; m.querySelector('summary')?.focus(); });
      });
      // Links marked data-nav-dir="back" slide the page the other way.
      document.addEventListener('astro:before-preparation', (e) => {
        const ev = e as Event & { sourceElement?: Element; direction: string };
        if (ev.sourceElement?.closest('[data-nav-dir="back"]')) ev.direction = 'back';
      });
      document.addEventListener('astro:after-swap', () => {
        try { const m = localStorage.getItem('eacp-motion'); if (m) root.dataset.motion = m; } catch (e) {}
      });
      window.addEventListener('eacp-auth-change', syncAuth);
      window.addEventListener(CHANGE_EVENT, syncAuth);
      document.addEventListener('astro:page-load', initChrome);
    </script>
  </body>
</html>

<style>
  header.site { position: sticky; top: 0; z-index: 50; background: #fff; border-bottom: var(--border); }
  .bar { display: flex; align-items: center; gap: var(--sp-3) var(--sp-5); min-height: var(--header-h); flex-wrap: wrap; }
  .brand { text-decoration: none; display: inline-flex; padding: 0.3rem 0; }
  .brand:hover :global(.wordmark) { color: var(--c-heritage-deep); }
  .primary ul { display: flex; list-style: none; margin: 0; padding: 0; gap: 2px; }
  .navlink { display: flex; align-items: center; min-height: 40px; padding: 0 0.85rem; border-radius: var(--radius-pill); color: var(--c-ink); text-decoration: none; font-size: var(--fs-sm); font-weight: 600; transition: background-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease); }
  .navlink:hover { background: var(--c-surface-alt); color: var(--c-heritage); }
  .navlink[aria-current='page'] { background: var(--c-selected); color: #fff; }
  .util { display: flex; align-items: center; gap: var(--sp-2) var(--sp-4); flex-wrap: wrap; margin-left: auto; }
  .menu { position: relative; }
  .menu summary { cursor: pointer; list-style: none; font-size: var(--fs-sm); font-weight: 600; color: var(--c-ink); min-height: 40px; display: flex; align-items: center; gap: 0.35rem; }
  .menu summary::-webkit-details-marker { display: none; }
  .menu summary::after { content: ''; width: 0.42em; height: 0.42em; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: rotate(45deg); margin: -0.2em 0 0 0.2em; }
  .menu ul { position: absolute; right: 0; top: calc(100% + 6px); min-width: 12rem; background: #fff; border: var(--border); border-radius: var(--radius-md); box-shadow: var(--shadow-panel); list-style: none; margin: 0; padding: var(--sp-2); z-index: 60; }
  .menu li a { display: block; padding: var(--sp-2) var(--sp-3); border-radius: var(--radius-sm); color: var(--c-ink); text-decoration: none; font-size: var(--fs-sm); }
  .menu li a:hover, .menu li a:focus-visible { background: var(--c-surface-alt); }
  .menu li a[aria-current='page'] { background: var(--c-selected); color: #fff; }
  .signin { font: 600 var(--fs-sm) var(--font-sans); color: #fff; background: var(--c-heritage); border: 0; border-radius: var(--radius-pill); padding: 0 1rem; min-height: 36px; cursor: pointer; }
  .signin:hover { background: var(--c-heritage-deep); }
  .signed { display: inline-flex; align-items: center; gap: var(--sp-2); font-size: var(--fs-xs); color: var(--c-muted); }
  .signed[hidden], .signin[hidden] { display: none; }
  .linkish { font: inherit; color: var(--c-link); background: none; border: 0; padding: 0.4rem 0; text-decoration: underline; cursor: pointer; min-height: 32px; }
  .motion { font: 500 var(--fs-xs) var(--font-sans); color: var(--c-muted); background: none; border: 1px solid var(--c-line); border-radius: var(--radius-pill); padding: 0.35rem 0.7rem; min-height: 32px; cursor: pointer; }
  .motion[aria-pressed='true'] { background: var(--c-surface-alt); color: var(--c-ink); border-color: var(--c-spirit); }
  footer.site { border-top: var(--border); background: var(--c-surface-alt); padding-block: var(--sp-5); font-size: var(--fs-xs); color: var(--c-muted); }
  .foot p { max-width: 60rem; margin: 0; }
  main:focus { outline: none; }
  @media (max-width: 760px) {
    header.site { position: static; }
    .bar { padding-block: var(--sp-2); }
    .bar { gap: var(--sp-2) var(--sp-3); }
    .primary { order: 3; width: 100%; overflow-x: auto; }
    .util { gap: var(--sp-2); flex-wrap: nowrap; }
    .who { display: none; }
    .motion { padding: 0.3rem 0.55rem; }
    .navlink { padding: 0 0.7rem; }
  }
</style>
